        "note": "Critical for muscle retention, bone health and metabolic rate in women 40+"
      },

      "carbohydrates": {
        "target": "180–220 g",
        "percentage": "40–45%",
        "note": "Supports training performance, thyroid health and mood"
      },

      "fats": {
        "target": "55–65 g",
        "percentage": "25–30%",
        "note": "Essential for hormonal balance and joint health"
      },

      "water": {
        "base": "2.5–3 L",
        "trainingDay": "3–3.2 L",
        "note": "Increase intake post-workout and during warm weather"
      },

